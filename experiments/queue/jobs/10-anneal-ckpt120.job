#!/usr/bin/env bash
# NEED_GPUS=2
# FREE_MB=5000
#
# Отжиг ckpt-120: доучить 10 шагов с крошечным LR и посмотреть, скакнёт ли скор
# к уровню ckpt-198 (0.7442).
#
# Кривая по чекпоинтам смешивает ДВЕ оси: сколько данных модель увидела и какой
# LR был в момент снятия. Cosine уводит LR в ноль к концу, и поздние чекпоинты
# уже поэтому «собраннее». Если ckpt-120 после отжига без единого нового примера
# даст ~0.74 — рост рисует расписание, а не данные.
set -uo pipefail
BASE=/mnt/storage-1/Screenshot2Code
# ROOT монтируется в контейнер как /out. Внутри образа sft общего диска по пути
# /mnt/storage-1 НЕ существует (он есть только у образа бенча), поэтому и веса,
# и вывод адресуются через /out — иначе HF принимает путь за имя репозитория.
ROOT=$BASE/checkpoints_exps/wc2m-15k-ab
CLEAN=clean/full_ft_qwen3_5_4b_s42_20260807-131309
# Микробатч 2, а не 4: на двух картах прогон занимает ~72 из 79 ГБ и падает,
# стоит соседу занять 7. При вдвое большем accum эффективный батч тот же — 64.
MICRO=2
ACCUM=$(( 64 / (MICRO * GPU_COUNT) )); (( ACCUM < 1 )) && ACCUM=1

env DATA_DIR="$BASE/data" HF_CACHE="$BASE/hf_cache" OUT_DIR="$ROOT" \
    GPUS="\"device=$GPU_IDS\"" CONTAINER_HOME="$BASE/container-home" \
    CLEARML_TAGS="wc2m15k-ab,anneal120" SFT_MAX_PIXELS=2097152 \
  "$REPO/SFT/run.sh" \
    torchrun --nproc_per_node="$GPU_COUNT" --tee 3 -m train.train_sft \
      --config configs/full_ft_qwen3_5_4b.yaml \
      --dataset_name /data/webcode2m_ab_clean_split \
      --model_name_or_path /out/$CLEAN/checkpoint-120 \
      --per_device_train_batch_size "$MICRO" --gradient_accumulation_steps "$ACCUM" \
      --learning_rate 1e-6 --lr_scheduler_type cosine --warmup_ratio 0 \
      --max_steps 10 --save_strategy no --eval_strategy no \
      --report_to clearml --output_dir /out/anneal120 || exit 1

W=$(ls -dt "$ROOT/anneal120"/*/ 2>/dev/null | head -1); W="${W%/}"
[[ -f "$W/config.json" ]] || { echo "весов нет в $ROOT/anneal120"; exit 1; }

env IMAGE_TAG=design2code-bench:kozlov \
    HOST_OUTDIR="$ROOT/bench/anneal120" HOST_HF_CACHE="$BASE/hf_cache" HOST_MODEL_DIR="$W" \
    CONTAINER_NAME="bench-anneal120" GPUS="\"device=${GPU_IDS%%,*}\"" SHM_SIZE=32g \
    CLEARML_TAGS="wc2m15k-ab,anneal120" \
  bash "$REPO/Evaluation/metrics_only/run.sh" --model "$W" \
    --hf-dataset SALT-NLP/Design2Code-hf --hf-config default --hf-split train \
    --n-samples 484 --batch-size 484 --max-pixels 2097152 \
    --tensor-parallel-size 1 --gpu-memory-utilization 0.50 \
    --max-new-tokens 16384 --num-workers 96
